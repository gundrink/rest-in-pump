# Optional absolute origin for Open Graph images. Vercel sets this from the deployment URL when unset.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Leave HELIUS_API_KEY empty to run entirely in mock mode.
# Mock mode serves labelled EXAMPLE tombstones and does not call Helius or DexScreener.
HELIUS_API_KEY=

# Public graveyard source. The MVP ships with "example" only.
# Add another source in lib/public-graveyard.ts, then set this and redeploy.
GRAVEYARD_SOURCE=example

# A coin is dead when drawdown is GREATER than this fraction.
# 0.9 means more than 90% below the peak. Exactly 90% stays alive.
DEAD_DRAWDOWN=0.9

# 24h volume at or under this many USD counts as near-zero.
DEAD_NEAR_ZERO_VOLUME_USD=500

# Consecutive near-zero days required for the volume rule.
# Live mode does not store a daily history. If DexScreener's 24h, 6h, and 1h
# volumes are all near zero, that streak is treated as this many days.
DEAD_LOW_VOLUME_DAYS=3

# In-memory server cache for live Helius and DexScreener responses.
# This is temporary. Wallet addresses are not written to a database.
CACHE_TTL_SECONDS=600

# Recent enhanced transactions to scan for mints the wallet used to hold.
HELIUS_TX_LIMIT=100

# DexScreener accepts up to 30 token addresses per request.
WALLET_MINT_CAP=30

# Polite cap on wallet lookups per IP per minute.
WALLET_RATE_LIMIT_PER_MINUTE=10
